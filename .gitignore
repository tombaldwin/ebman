/target

# macOS
.DS_Store

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Local caches and crash reports (ebman writes to ~/.cache; safety net for any in-tree runs)
*.log
crash-*.log

# Claude Code working directory
.claude/

# candor: the scan reports are derived artefacts (regenerate with
# `candor-scan .`) and `deps/` is a per-machine cache — but the
# POLICY is source and must be tracked, or the CI gate has nothing to
# read. This used to ignore `.candor/` wholesale, which would have
# shipped a gate with no policy behind it.
.candor/report.*.json
.candor/deps/
.candor/cache/
