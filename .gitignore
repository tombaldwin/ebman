/target

# macOS
.DS_Store

# Editors
*.swp
*.swo
*~
.idea/
.vscode/

# Local caches and crash reports (ebman writes to ~/.cache; safety net for any in-tree runs)
*.log
crash-*.log

# Claude Code working directory
.claude/

# Candor scanner local reports
.candor/

# candor: the scan reports are derived artefacts (regenerate with
# `candor-scan .`), and `deps/` is a per-machine dependency cache.
# `.candor/policy` is the source of truth and IS tracked.
.candor/report.*.json
.candor/deps/
.candor/cache/
