#!/usr/bin/env bash
# pre-commit hook for ebman, tracked in `.githooks/` and installed by
# `scripts/install-hooks.sh`. Runs the CI checks that are cheap enough
# to fire on every commit:
#   1. no staged path or line names a protected client (see
#      `.githooks/protected-names.sh`), before it is in history;
#      nor widens the mutation allowlist, without the maintainer;
#   2. `cargo fmt --all -- --check`  — ~1s;
#   3. `cargo clippy --all-targets -- -D warnings` — ~5–15s warm,
#      slower cold; catches doc-lint / dead-code / etc. that have
#      bounced CI in the past.
#
# Slower CI checks (cargo build, cargo test, msrv, codeql) stay
# server-side — they take long enough that running them per-commit
# would discourage actually committing.
#
# Skip with: `git commit --no-verify` (don't make a habit of it —
# that pushes the breakage to CI).

set -e

# 1. Protected client names, first: it needs no cargo, and a missing
# toolchain must not skip it. Staged paths as well as added lines: a new
# file's NAME has leaked a client before.
. "$(git rev-parse --show-toplevel)/.githooks/protected-names.sh"
staged=$(mktemp)
{
  # quotePath off: a non-ASCII path would otherwise be octal escapes.
  git -c core.quotePath=false diff --cached --name-only --diff-filter=ACRM
  git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' || true
} > "$staged"
if check_protected_names "a staged path or line" "$staged"; then status=0; else status=$?; fi
rm -f "$staged"
[ "$status" = 0 ] || exit 1

# 1b. The mutation allowlist is the maintainer's (CLAUDE.md, stop
# conditions): an `exclude_re` entry in `.cargo/mutants.toml`, or a
# `mutants::skip` attribute (not a mention of one in prose), hides a
# surviving mutant from every run, and was a rule in prose only.
# Refused unless the maintainer says so.
if [ "${EBMAN_MAINTAINER:-}" != 1 ]; then
  allow=""
  if git diff --cached --name-only | grep -qxF '.cargo/mutants.toml'; then
    allow=".cargo/mutants.toml"
  elif git diff --cached -U0 --no-color -- '*.rs' | grep '^+' | grep -v '^+++' | grep -qE '#!?\[.*mutants::skip'; then
    allow="a mutants::skip attribute"
  fi
  if [ -n "$allow" ]; then
    echo "pre-commit: this commit changes $allow, the mutation allowlist." >&2
    echo "Only the maintainer widens it: a surviving mutant gets a test (CLAUDE.md," >&2
    echo "stop conditions). The maintainer commits with EBMAN_MAINTAINER=1." >&2
    exit 1
  fi
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "pre-commit: cargo not on PATH, skipping checks" >&2
  exit 0
fi

# Only run if Cargo.toml is present at the repo root — protects
# against running this hook from inside an unrelated checkout.
if [ ! -f Cargo.toml ]; then
  exit 0
fi

# 2. Formatting check (fast).
if ! cargo fmt --all -- --check; then
  echo
  echo "pre-commit: formatting differences detected. Run:" >&2
  echo "  cargo fmt --all" >&2
  echo "then re-stage and re-commit." >&2
  exit 1
fi

# 3. Clippy (slower; matches the CI invocation exactly so failures
# here mirror failures there). Uses `--all-targets` so test code
# gets linted alongside lib + bin. `-D warnings` promotes every
# clippy warning to a hard error.
if ! cargo clippy --all-targets -- -D warnings 2>&1; then
  echo
  echo "pre-commit: clippy found issues. Fix them, then re-stage and" >&2
  echo "re-commit. (Reaching for #[allow(...)] is a stop condition in" >&2
  echo "CLAUDE.md, not a fix.)" >&2
  exit 1
fi
